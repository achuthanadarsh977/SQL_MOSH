
CREATE TABLE CUSTOMERS(
ID int NOT NULL,
NAME text NOT NULL,
AGE INT NOT NULL,
SALARY INT NOT NULL,
ADDRESS TEXT NOT NULL,
PRIMARY KEY(ID)
);


CREATE TABLE USERS(
NAME TEXT NOT NULL,
PHONE_NUMBER TEXT NOT NULL,
EMAIL TEXT NOT NULL
);

