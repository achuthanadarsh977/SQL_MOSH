CREATE OR REPLACE PROCEDURE SHOW_CUSTOMERS
IS
BEGIN
  FOR REC IN (SELECT ID , NAME FROM CUSTOMERS) LOOP
       DBMS_OUTPUT.PUT_LINE('ID:'|| REC.ID || 'NAME:' || REC.NAME)
  END LOOP;
END SHOW_CUSTOMERS;
/


CREATE OR REPLACE PROCEDURE SHOW_SALARY
IS
P_ID NUMBER;
BEGIN
  
  FOR REC IN (SELECT ID INTO P_ID FROM CUSTOMERS WHERE SALARY >= (SELECT AVG(SALARY) FROM CUSTOMERS)) LOOP
      DBMS_OUTPUT.PUT_LINE('Customer ID:'|| P_ID);
  END LOOP;

END SHOW_SALARY;
/

CREATE OR REPLACE PROCEDURE PROC_SALARY(P_NAME OUT VARCHAR2)
IS
BEGIN
  FOR REC IN (SELECT NAME INTO P_NAME FROM CUSTOMERS WHERE SALARY >= (SELECT AVG(SALARY) FROM CUSTOMERS)) LOOP
      DBMS_OUTPUT.PUT_LINE('Customer Name:'|| P_NAME);
  END LOOP;
END PROC_SALARY;
/


CREATE OR REPLACE PROCEDURE SHOW_USERS
    IS
    BEGIN
      FOR ROC IN (SELECT AGE , PHONE_NUMBER FROM USERS) LOOP
          DBMS_OUTPUT.PUT_LINE('CUSTOMER AGE:' || ROC.AGE || 'CUSTOMER PHONE_NUMBER:' || ROC.PHONE_NUMBER);
      END LOOP;
    END SHOW_USERS;
    /

CREATE OR REPLACE SHOW_PRODUCTS
IS
BEGIN
  FOR RIC IN (SELECT PRICE , PRODUCT_NAME , ORDER_ID FROM PRODUCTS) LOOP
      DBMS_OUTPUT.PUT_LINE('PRICE:'|| RIC.NAME || 'PRODUCT_NAME:' || RIC.PRODUCT_NAME || 'ORDER_ID:' || RIC.ORDER_ID);
  END LOOP;
END SHOW_PRODUCTS;
/

